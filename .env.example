# Copy this file to `.env` in the project root (and/or `backend/.env` for local,
# non-Docker backend runs) and fill in real values.

# --- App ---
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# SQLite for Phase 1 -- zero setup. Swap to a Postgres DSN later if/when you need it,
# e.g. postgresql+psycopg2://user:pass@host:5432/db (also uncomment psycopg2-binary
# in backend/requirements.txt).
DATABASE_URL=sqlite:///./repomind.db

# --- Qdrant ---
# Empty = embedded local mode (no server, no Docker needed) -- fine for Phase 1 dev.
# Set to http://localhost:6333 (or the docker-compose qdrant service) to use a real server.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=repomind_chunks
QDRANT_LOCAL_PATH=qdrant_data

# --- LLM ---
# Primary provider: one of "gemini" | "openrouter" | "ollama".
# Fallback chain: Gemini (primary) -> OpenRouter (if OPENROUTER_API_KEY set) -> Ollama
# (local, no rate limit -- the one option that can't itself get rate-limited, so it's
# the last resort) -- see backend/app/ai/llm/factory.py.
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-2.5-flash
GEMINI_API_KEY=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free-tier OpenRouter model IDs rotate frequently (weekly, per OpenRouter). Verify at
# https://openrouter.ai/models?max_price=0 or `GET https://openrouter.ai/api/v1/models`
# before relying on this default.
OPENROUTER_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b:free

OLLAMA_BASE_URL=http://localhost:11434
# `ollama pull llama3.1:8b` -- comfortably runs on 4GB+ VRAM or 16GB RAM CPU-only.
OLLAMA_MODEL=llama3.1:8b

# --- Embeddings ---
# One of "gemini" | "bge" | "nomic" | "ollama" | "openai".
# "ollama" runs fully local, no API key: `ollama pull nomic-embed-text` then leave as default.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL_NAME=nomic-embed-text
OPENAI_API_KEY=

# --- Integrations ---
# Optional, but recommended: raises GitHub's unauthenticated API rate limit and allows
# cloning private repos.
GITHUB_TOKEN=

# --- Storage (paths are relative to backend/ when run locally) ---
REPOSITORIES_DIR=repositories
UPLOADS_DIR=uploads
GENERATED_REPORTS_DIR=generated_reports

LOG_LEVEL=INFO

# --- Frontend build-time var (see frontend/.env.example) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
